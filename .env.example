# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
# Bootstrap superuser (owns the server + runs the init scripts).
POSTGRES_USER=postgres
POSTGRES_ADMIN_PASSWORD=change_me_admin
POSTGRES_DB=medicoder

# Application roles (created by docker/postgres/01-roles.sh).
#   medicoder -> read/write (ingestion + app)
#   agent     -> SELECT-only (connect the LangChain scoped SQL tool here)
MEDICODER_PASSWORD=change_me_app
AGENT_PASSWORD=change_me_agent

# LiteLLM audit database (created by docker/postgres/02-litellm.sh).
#   Stores every LLM call + response (LiteLLM_SpendLogs via Prisma migration).
LITELLM_DB_PASSWORD=change_me_litellm

# ---------------------------------------------------------------------------
# Upstream LLM (LiteLLM forwards the model alias here)
# ---------------------------------------------------------------------------
# Any OpenAI-compatible endpoint. Use a LiteLLM provider prefix in the model:
#   - Cloud:         openai/gpt-4o-mini        + https://api.openai.com/v1
#                    anthropic/claude-3-5-sonnet + https://api.anthropic.com/v1
#   - Self-deployed: openai/<your-model>       + https://your-server/v1
#   - Ollama on host: ollama/llama3.2          + http://host.docker.internal:11434
LLM_UPSTREAM_MODEL=openai/gpt-4o-mini
LLM_UPSTREAM_API_BASE=https://api.openai.com/v1
LLM_UPSTREAM_API_KEY=sk-change-me

# ---------------------------------------------------------------------------
# Program <-> LiteLLM
# ---------------------------------------------------------------------------
# The app always talks to the local LiteLLM proxy (you rarely change this).
LLM_BASE_URL=http://litellm:4000/v1
# Model alias defined in docker/litellm/config.yaml (default "A").
LLM_MODEL=A

# ---------------------------------------------------------------------------
# LiteLLM (optional)
# ---------------------------------------------------------------------------
# Uncomment to require an API key on the LiteLLM proxy. The app must then send
# Authorization: Bearer <key>. Also uncomment master_key in config.yaml.
# LITELLM_MASTER_KEY=sk-change-me

# ---------------------------------------------------------------------------
# Local GPU Ollama (only used by the gpu-amd / gpu-nvidia debug profiles)
# ---------------------------------------------------------------------------
# Model tag Ollama serves on http://ollama:11434 when running the in-container
# GPU Ollama overlay (docker/docker-compose.gpu.yml). Ignored in cloud/host mode.
# Pull it once: docker compose ... --profile gpu-amd exec ollama-amd ollama pull llama3.2
OLLAMA_MODEL=llama3.2
