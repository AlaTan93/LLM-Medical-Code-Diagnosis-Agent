# Written by AI
# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
# Bootstrap superuser (owns the server + runs the init scripts).
POSTGRES_USER=postgres
POSTGRES_ADMIN_PASSWORD=change_me_admin
POSTGRES_DB=medicoder

# Application role (created by docker/postgres/01-roles.sh).
#   medicoder -> read/write (ingestion + app)
MEDICODER_PASSWORD=change_me_app

# LiteLLM audit database (created by docker/postgres/02-litellm.sh).
#   Stores every LLM call + response (LiteLLM_SpendLogs via Prisma migration).
LITELLM_DB_PASSWORD=change_me_litellm

# ---------------------------------------------------------------------------
# Program <-> LiteLLM
# ---------------------------------------------------------------------------
# The app always talks to the local LiteLLM proxy (you rarely change this).
# LiteLLM in turn only ever talks to in-container Ollama models — there is no
# cloud or remote-endpoint option, by design (patient data stays local).
LLM_BASE_URL=http://litellm:4000/v1

# ---------------------------------------------------------------------------
# Local GPU Ollama (gpu-amd / gpu-nvidia profiles — required to run the stack)
# ---------------------------------------------------------------------------
# Models listed in models.toml auto-pull via the ollama-init sidecar on `up`.
# HuggingFace token, read by the in-container Ollama SERVER (ollama-amd /
# ollama-nvidia) for hf.co/ model pulls. Leave blank for public repos, but set
# it to avoid HuggingFace rate limits on large GGUF downloads.
HF_TOKEN=

# ---------------------------------------------------------------------------
# LLM proxy timeouts & token limits (medicoder/proxy.py)
# ---------------------------------------------------------------------------
# urllib timeout (seconds) for /chat/completions requests.
CHAT_TIMEOUT=600.0
# urllib timeout (seconds) for /embeddings requests.
EMBED_TIMEOUT=120.0
# Default max_tokens for chat_completion(); overridden by diagnose/critic callers.
MAX_TOKENS=8192

# ---------------------------------------------------------------------------
# Diagnose pipeline (medicoder/medical.py, used by /code and /diagnose)
# ---------------------------------------------------------------------------
# Max number of diagnoses a medical model can output per case.
MAX_DIAGNOSES=10
# Max LLM retry attempts when the model output fails to parse.
DIAGNOSE_MAX_RETRIES=4
# Temperature increment added per retry attempt.
DIAGNOSE_TEMP_INCREMENT=0.05
# Upper bound clamping temperature during retries.
DIAGNOSE_MAX_TEMP=0.3
# Token budget for the first diagnose attempt (full reasoning prompt).
DIAGNOSE_MAX_TOKENS=4096
# Token budget for retry attempts (concise prompt, suppresses thinking).
DIAGNOSE_CONCISE_TOKENS=2048

# ---------------------------------------------------------------------------
# Debate-critic loop (/diagnose endpoint — medicoder/critic.py + diagnose.py)
# ---------------------------------------------------------------------------
# When the two medical models disagree (different top-1 ICD-10 code or
# different diagnosis counts), a critic agent reconciles their outputs.
# Max reconciliation rounds (0 = disabled).
MAX_CRITIC_ROUNDS=2
# LiteLLM aliases for the two medical models and the critic.
MODEL_A=medgemma-27b-q4_k_s
MODEL_B=deepseek-r1-medical-cot
CRITIC_MODEL=deepseek-r1-medical-cot
# Critic sampling temperature.
CRITIC_TEMP=0.1
# Critic token budget per round.
CRITIC_MAX_TOKENS=8192
# Max tool iterations per critic round (search/lookup/get against the code DB).
CRITIC_MAX_TOOL_CALLS=8

# ---------------------------------------------------------------------------
# Search tuning (medicoder/medical.py — vector similarity search)
# ---------------------------------------------------------------------------
# Number of candidates to fetch per query before dedup/ranking.
SEARCH_CANDIDATE_K=15

# ---------------------------------------------------------------------------
# Embedding batch size (medicoder/db/embed_icd10.py)
# ---------------------------------------------------------------------------
# Number of rows embedded per LiteLLM /v1/embeddings API call.
EMBED_BATCH_SIZE=128