# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
# Bootstrap superuser (owns the server + runs the init scripts).
POSTGRES_USER=postgres
POSTGRES_ADMIN_PASSWORD=change_me_admin
POSTGRES_DB=medicoder

# Application roles (created by docker/postgres/01-roles.sh).
#   medicoder -> read/write (ingestion + app)
#   agent     -> SELECT-only (connect the LangChain scoped SQL tool here)
MEDICODER_PASSWORD=change_me_app
AGENT_PASSWORD=change_me_agent

# LiteLLM audit database (created by docker/postgres/02-litellm.sh).
#   Stores every LLM call + response (LiteLLM_SpendLogs via Prisma migration).
LITELLM_DB_PASSWORD=change_me_litellm

# ---------------------------------------------------------------------------
# Ollama (local LLM) -- only needed with the --profile amd|nvidia runs
# ---------------------------------------------------------------------------
# Max models held in VRAM simultaneously. Keep 1 to bound VRAM on the 7900 XTX.
OLLAMA_MAX_LOADED_MODELS=1
# How long a loaded model stays resident after the last request before unloading.
OLLAMA_KEEP_ALIVE=5m
# RX 7900 XTX = gfx1100. Override only if running a different RDNA3 card.
HSA_OVERRIDE_GFX_VERSION=gfx1100

# ---------------------------------------------------------------------------
# Program <-> LLM
# ---------------------------------------------------------------------------
# LiteLLM proxy (model alias routing + audit logging) for profile runs.
# For 2-container mode (external LLM), set this to your endpoint instead, e.g.
#   LLM_BASE_URL=https://api.openai.com/v1
LLM_BASE_URL=http://litellm:4000/v1
# Model alias defined in docker/litellm/config.yaml (e.g. "A"). The alias maps
# to an Ollama tag; pull tags with: docker compose exec ollama ollama pull <tag>
LLM_MODEL=A

# ---------------------------------------------------------------------------
# LiteLLM (optional)
# ---------------------------------------------------------------------------
# Uncomment to require an API key on the LiteLLM proxy. The app must then send
# Authorization: Bearer <key>. Also uncomment master_key in config.yaml.
# LITELLM_MASTER_KEY=sk-change-me
