-- Optional: enable vector similarity search (the "Option 2" path).
-- The pgvector extension is already installed by 00-schema.sql; this file only
-- adds the embedding column + index when you have chosen an embedding model.
--
-- This file is NOT run automatically (the .example suffix excludes it from the
-- init directory). Run it manually against the medicoder database once, after
-- editing the dimension to match your embedding model:
--
--   psql -h localhost -U medicoder -d medicoder \
--        -f docker/postgres/02-embedding.sql.example
--
-- Common dimensions: 384 (bge-small), 768 (bge-base / e5-base), 1024 (bge-large, nomic-embed).

CREATE EXTENSION IF NOT EXISTS vector;

ALTER TABLE public.icd10_codes
    ADD COLUMN IF NOT EXISTS embedding vector(1024);

-- HNSW over only billable rows (the rows that actually get embedded).
CREATE INDEX IF NOT EXISTS idx_icd10_codes_embedding
    ON public.icd10_codes USING hnsw (embedding vector_cosine_ops)
    WITH (m = 16, ef_construction = 64)
    WHERE is_billable;
